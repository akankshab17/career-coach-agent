# Copy to .env.local for local development. Never commit real values.
# Where the FastAPI service is (local: uvicorn --app-dir src --factory api:serve, from the repo root).
FASTAPI_URL=http://localhost:8000
# Shared server-to-server key; must equal INTERNAL_API_KEY on the FastAPI side. Blank = FastAPI is open (local only).
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=
# The code people type on the login page (share it privately). 16+ random characters.
APP_ACCESS_CODE=
# Signs the session cookie: 32+ random characters (openssl rand -hex 32). Changing it logs everyone out.
SESSION_SECRET=

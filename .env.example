TAVILY_API_KEY=tvly-your-key
GROQ_API_KEY=gsk_your-key
OPENAI_API_KEY=sk-your-key   # needed if LLM_PROVIDER=openai or FALLBACK_PROVIDER=openai
LLM_PROVIDER=groq            # groq (default) or openai
EXTRACT_MODEL=               # blank = default (groq: openai/gpt-oss-20b); many small extraction calls
WRITE_MODEL=                 # blank = default (groq: openai/gpt-oss-120b); one writing call
LLM_MODEL=                   # optional: one model for both tasks (EXTRACT_MODEL/WRITE_MODEL win if set)
EXTRACT_REASONING_EFFORT=    # low | medium | high; blank = low. Groq gpt-oss and OpenAI reasoning models only
WRITE_REASONING_EFFORT=      # low | medium | high; blank = medium. Groq gpt-oss and OpenAI reasoning models only

# Fallback provider, used only when Groq hits a DAILY limit (tokens/requests per day), and only for the task
# (extract or write) whose model hit it, for the rest of that run. Blank FALLBACK_PROVIDER = no fallback.
FALLBACK_PROVIDER=openai
# Model for fact extraction on the fallback (many small calls). Must have a price in PRICES (src/llm.py).
FALLBACK_EXTRACT_MODEL=gpt-5.6-luna
# Model for the one writing call on the fallback.
FALLBACK_WRITE_MODEL=gpt-5.4-mini
# Stop using the OpenAI fallback once tracked spend reaches this many dollars (default 3.00).
# Spend is summed across runs in .cache/spend.json; delete that file to start counting from zero.
OPENAI_BUDGET_USD=3.00

# Web app (see README "Web app"). If set, the API requires this code in the X-Access-Code header and the
# Streamlit app asks for it once per browser session. Leave blank for local use. Set it before exposing the app publicly.
APP_ACCESS_CODE=
# Where the Streamlit app finds the API (default http://localhost:8000).
BRIEF_API_URL=
